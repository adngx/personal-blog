---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found"
  description="The page you are looking for does not exist."
>
  <main
    id="main-content"
    class="mx-auto flex min-h-[60vh] max-w-[var(--container-prose)] flex-col items-center justify-center px-6 py-24 text-center sm:py-32"
  >
    <h1 class="text-5xl font-bold tracking-tight">Page not found</h1>
    <p class="text-muted-foreground mt-4 text-lg">
      Sorry, the page you are looking for does not exist or has been moved.
    </p>
    <a
      href="/"
      class="bg-foreground text-background mt-10 inline-block rounded-md px-6 py-2 text-sm font-medium hover:opacity-90"
    >
      Back to home
    </a>
  </main>
</Layout>
