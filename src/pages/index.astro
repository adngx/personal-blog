---
import Layout from "../layouts/Layout.astro";
import { buttonVariants } from "../components/ui/button";
import { NewsletterSignup } from "../components/newsletter/newsletter-signup";
import SocialButtons from "../components/social-buttons.astro";
import { formatDate } from "../lib/format-date";
import { cn } from "../lib/utils";
import { getCollection } from "astro:content";
import { socialLinks } from "../data/social-links";
import { AUTHOR_NAME, AUTHOR_DESCRIPTION } from "../data/identity";
import { SITE_URL, SITE_NAME } from "../env";
import myPhoto from "../assets/my-photo.png";

const posts = (await getCollection("posts"))
  .filter((post) => !import.meta.env.PROD || !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0] ?? null;

const personId = new URL("/about/", SITE_URL).href + "#person";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/", SITE_URL).href + "#website",
      name: SITE_NAME,
      url: SITE_URL,
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: AUTHOR_NAME,
      url: SITE_URL,
      description: AUTHOR_DESCRIPTION,
      sameAs: socialLinks
        .filter((link) => link.url.startsWith("http"))
        .map((link) => link.url),
    },
  ],
};
---

<Layout
  title="Home"
  description="A personal blog about learning cybersecurity in public. Posts for students and aspiring security engineers."
>
  <main id="main-content">
    <header
      class="mx-auto max-w-[var(--container-wide)] px-6 pt-24 pb-24 sm:pt-32 sm:pb-32"
    >
      <div class="flex flex-col gap-10 sm:flex-row sm:items-center sm:gap-16">
        <div class="min-w-0 flex-1">
          <h1 class="text-5xl font-bold tracking-tight sm:text-6xl">
            Anh-Duc Nguyen
          </h1>
          <p class="text-muted-foreground mt-3 text-lg sm:text-xl">
            Aspiring Security Engineer
          </p>
          <p class="mt-6 max-w-2xl text-lg sm:text-xl">
            I learn cybersecurity in public. Writing helps me think clearly, and
            sharing publicly keeps me honest. If even one person finds a post
            useful, that's a win:)
          </p>
          <div class="mt-8">
            <SocialButtons />
          </div>
        </div>
        <img
          src={myPhoto.src}
          alt="Portrait photo of Anh-Duc Nguyen"
          class="mx-auto h-auto w-64 shrink-0 rounded-lg sm:mx-0 sm:w-80"
        />
      </div>
    </header>

    {
      featuredPost && (
        <section
          aria-labelledby="featured-heading"
          class="mx-auto max-w-[var(--container-wide)] px-6 pb-24 sm:pb-32"
        >
          <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
            <h2 id="featured-heading" class="text-3xl font-bold sm:text-4xl">
              Featured post
            </h2>
            <a
              href="/blog"
              class={cn(
                buttonVariants({ variant: "default" }),
                "h-10 px-5 text-base hover:no-underline",
              )}
            >
              View all posts
            </a>
          </div>
          <div class="mt-10">
            <a
              href={`/posts/${featuredPost.id}`}
              class="text-foreground text-xl font-semibold break-words hover:underline sm:text-2xl"
            >
              {featuredPost.data.title}
            </a>
            <time
              class="text-muted-foreground mt-3 block text-sm sm:text-base"
              datetime={featuredPost.data.pubDate.toISOString()}
            >
              {formatDate(featuredPost.data.pubDate)}
            </time>
            <p class="text-muted-foreground mt-5 text-base sm:text-lg">
              {featuredPost.data.description}
            </p>
          </div>
        </section>
      )
    }

    <div class="mx-auto max-w-[var(--container-wide)] px-6 pb-24 sm:pb-32">
      <NewsletterSignup client:visible card={false} />
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
