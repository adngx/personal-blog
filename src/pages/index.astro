---
import Layout from "../layouts/Layout.astro";
import { buttonVariants } from "../components/ui/button";
import { Badge } from "../components/ui/badge";
import { NewsletterSignup } from "../components/newsletter/newsletter-signup";
import { formatDate } from "../lib/format-date";
import { getCollection } from "astro:content";
import { socialLinks } from "../data/social-links";
import { AUTHOR_NAME, AUTHOR_DESCRIPTION } from "../data/identity";
import { SITE_URL, SITE_NAME } from "../env";

const posts = (await getCollection("posts"))
  .filter((post) => !import.meta.env.PROD || !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0] ?? null;

const personId = new URL("/about/", SITE_URL).href + "#person";

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/", SITE_URL).href + "#website",
      name: SITE_NAME,
      url: SITE_URL,
      publisher: { "@id": personId },
    },
    {
      "@type": "Person",
      "@id": personId,
      name: AUTHOR_NAME,
      url: SITE_URL,
      description: AUTHOR_DESCRIPTION,
      sameAs: socialLinks
        .filter((link) => link.url.startsWith("http"))
        .map((link) => link.url),
    },
  ],
};
---

<Layout
  title="Home"
  description="A personal blog about learning cybersecurity in public. Posts for students and aspiring security engineers."
>
  <main id="main-content">
    <header
      class="bg-card mx-auto max-w-[var(--container-prose)] rounded-lg p-6"
    >
      <h1 class="text-4xl font-bold tracking-tight">Anh-Duc Nguyen</h1>
      <p class="text-muted-foreground mt-2">Aspiring Security Engineer</p>
      <p class="mt-4 max-w-prose">
        I learn cybersecurity in public. Writing helps me think clearly, and
        sharing publicly keeps me honest. If even one person finds a post
        useful, that's a win:)
      </p>
    </header>

    {
      featuredPost && (
        <section
          aria-labelledby="featured-heading"
          class="bg-card mx-auto mt-8 max-w-[var(--container-prose)] rounded-lg p-6"
        >
          <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
            <h2 id="featured-heading" class="text-2xl font-bold">
              Featured post
            </h2>
            <a
              href="/blog"
              class={
                buttonVariants({ variant: "outline", size: "sm" }) +
                " hover:no-underline"
              }
            >
              View all posts
            </a>
          </div>
          <div class="border-border mt-5 border-t pt-5">
            <a
              href={`/posts/${featuredPost.id}`}
              class="text-foreground text-xl font-semibold hover:underline"
            >
              {featuredPost.data.title}
            </a>
            <time
              class="text-muted-foreground mt-1 block text-sm"
              datetime={featuredPost.data.pubDate.toISOString()}
            >
              {formatDate(featuredPost.data.pubDate)}
            </time>
            {featuredPost.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {featuredPost.data.tags.map((tag) => (
                  <Badge variant="secondary">{tag}</Badge>
                ))}
              </div>
            )}
            <p class="text-muted-foreground mt-3">
              {featuredPost.data.description}
            </p>
          </div>
        </section>
      )
    }

    <div class="mx-auto mt-8 max-w-[var(--container-prose)]">
      <NewsletterSignup client:visible />
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
