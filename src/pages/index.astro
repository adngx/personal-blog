---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("posts"))
  .filter((post) => !import.meta.env.PROD || !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Home">
  <main
    id="main-content"
    class="mx-auto max-w-[var(--container-prose)] px-6 py-12"
  >
    <h1 class="text-4xl font-bold">Personal Blog</h1>
    <p class="text-muted-foreground mt-4 text-lg">
      Learning computer science in public.
    </p>
    <section class="mt-12">
      <h2 class="text-2xl font-semibold">Posts</h2>
      <ul class="mt-4 space-y-4">
        {
          posts.map((post) => (
            <li>
              <a
                href={`/posts/${post.id}`}
                class="text-link text-lg hover:underline"
              >
                {post.data.title}
              </a>
              <p class="text-muted-foreground text-sm">
                {post.data.pubDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <p class="text-muted-foreground mt-1">{post.data.description}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Layout>
