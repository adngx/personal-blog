---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <article
    id="main-content"
    class="mx-auto max-w-[var(--container-prose)] px-6 py-12"
  >
    <header class="mb-8">
      <h1 class="text-4xl font-bold">{post.data.title}</h1>
      <time class="text-muted-foreground mt-2 block text-sm">
        {
          post.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
    </header>
    <div class="prose prose-gray max-w-none">
      <Content />
    </div>
    <footer class="border-border mt-12 border-t pt-4">
      <a href="/" class="text-link hover:underline">← Back to home</a>
    </footer>
  </article>
</Layout>
