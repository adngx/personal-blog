---
import { socialLinks } from "../data/social-links";
import { SITE_NAME } from "../env";

const currentYear = new Date().getFullYear();
---

<footer class="border-border bg-background border-t">
  <div
    class="mx-auto flex max-w-[var(--container-wide)] flex-col items-center gap-6 px-6 py-8 md:flex-row md:justify-between"
  >
    <nav
      aria-label="Footer"
      class="flex flex-col items-center gap-4 md:flex-row md:gap-6"
    >
      <a
        href="/"
        class="text-muted-foreground hover:text-foreground text-sm font-medium transition-colors"
      >
        Blog
      </a>
      <a
        href="/about"
        class="text-muted-foreground hover:text-foreground text-sm font-medium transition-colors"
      >
        About
      </a>
      <a
        href="/privacy-policy"
        class="text-muted-foreground hover:text-foreground text-sm font-medium transition-colors"
      >
        Privacy
      </a>
      <ul class="flex items-center gap-4" aria-label="Social links">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.url}
                class="text-muted-foreground hover:text-foreground text-sm font-medium transition-colors"
                {...(link.url.startsWith("http")
                  ? { rel: "noopener", target: "_blank" }
                  : {})}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex flex-col items-center gap-4 md:flex-row md:gap-6">
      <p class="text-muted-foreground text-sm">
        &copy; {currentYear}
        {SITE_NAME}
      </p>
      <a
        href="https://astro.build"
        rel="noopener"
        target="_blank"
        aria-label="Built with Astro"
      >
        <img
          src="https://astro.badg.es/v2/built-with-astro/tiny.svg"
          alt="Built with Astro"
          width="120"
          height="20"
          loading="lazy"
        />
      </a>
    </div>
  </div>
</footer>
